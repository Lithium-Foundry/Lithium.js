{
  "name": "@nivalos/lithium.js",
  "version": "1.6.0",
  "description": "Creating a proxy has never been easier with Lithium.js",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lithium-Foundry/Lithium.js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server/start.js",
    "test": "echo \"no automated tests are bundled, run `npx lithium doctor` to check your install\""
  },
  "keywords": [
    "lithium",
    "lithium-js",
    "lithium-proxy",
    "scramjet",
    "ultraviolet",
    "bare-mux",
    "epoxy-transport",
    "libcurl-transport",
    "wisp-js",
    "mercuryworkshop",
    "proxy-server",
    "web-unblocker",
    "nodejs",
    "express",
    "self-hosted-proxy",
    "reverse-proxy",
    "bypass",
    "webview",
    "frontend-proxy",
    "uv-proxy",
    "school-unblocker",
    "browser-proxy",
    "javascript",
    "network-tunneling"
  ],
  "author": "nivalos",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/epoxy-transport": "^3.0.1",
    "@mercuryworkshop/libcurl-transport": "^2.0.5",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/scramjet-utils": "0.0.3",
    "@mercuryworkshop/wisp-js": "^0.5.0",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "cheerio": "^1.2.0",
    "epoxy-transport-bm": "npm:@mercuryworkshop/epoxy-transport@^2.1.28",
    "express": "^5.2.1",
    "libcurl-transport-bm": "npm:@mercuryworkshop/libcurl-transport@^1.5.2"
  },
  "files": [
    "server",
    "client",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "lithium": "bin/lithium.js"
  }
}
